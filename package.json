{
  "name": "@matthesketh/feedback-relay",
  "version": "0.1.0",
  "description": "Let an app send bug reports and ideas to GitHub issues through your own server, with app attestation, PII scrubbing and rate limits.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wrxck/feedback-relay.git"
  },
  "homepage": "https://github.com/wrxck/feedback-relay#readme",
  "bugs": {
    "url": "https://github.com/wrxck/feedback-relay/issues"
  },
  "author": "Matt Hesketh <matt@matthesketh.pro>",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "feedback",
    "bug-report",
    "github-issues",
    "github-app",
    "app-attest",
    "devicecheck",
    "ios",
    "capacitor"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "cborg": "6.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.5"
  }
}
